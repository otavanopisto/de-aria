{
  "compilerOptions": {
    "module": "esnext",
    "checkJs": true,
    "strict": true,
    "moduleResolution": "node",
    "target": "es2020",
    "moduleDetection": "force",
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
  },
  "typeAcquisition": {"enable": false},
  "include": ["js/**/*.js"],
  "exclude": ["node_modules"]
}